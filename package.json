{
  "name": "friends",
  "version": "0.3.1",
  "description": "A personal AI chat app",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "build": "npm run check",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "desktop": "electron . --no-sandbox",
    "dist": "node scripts/build-deb.js",
    "update": "bash scripts/update.sh",
    "backup": "node scripts/backup.js",
    "doctor": "node scripts/doctor.js",
    "setup": "bash scripts/install.sh",
    "voice:setup": "node scripts/local-voice.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "test:voice": "node scripts/e2e-voice.js",
    "test:desktop": "node scripts/e2e-desktop.js"
  },
  "license": "MIT",
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "dompurify": "^3.4.16",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "puppeteer-core": "^25.12.0"
  },
  "desktopName": "friends.desktop"
}
